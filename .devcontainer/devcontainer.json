{
  "name": "Eksploracja danych: analiza koszyka",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "postCreateCommand": "pip install -r requirements.txt notebook ipykernel",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"]
    }
  },
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": { "label": "Streamlit", "onAutoForward": "notify" }
  }
}
